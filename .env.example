FERN_ENV=local
FERN_DATABASE_URL=postgresql://fern:fern@localhost:54329/fern
FERN_SESSION_SECRET=change-me
# Column sandbox key (starts with test_). Never commit a real key.
FERN_COLUMN_API_KEY=
# sim | column
FERN_BANK=sim
# Live demo: only hand out pre-funded pool spaces (make pool); 503 when the pool is empty.
FERN_POOL_ONLY=false
# Linked accounts: sim | sandbox (Plaid sandbox; needs the client id and secret)
FERN_PLAID=sim
FERN_PLAID_CLIENT_ID=
FERN_PLAID_SECRET=
# Rate limits (token bucket per space). Empty: no limiter.
FERN_REDIS_URL=redis://localhost:63799/0
FERN_RATE_LIMIT_PER_MINUTE=30
