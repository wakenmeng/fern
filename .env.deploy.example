# Copy to .env.deploy (gitignored) for `make deploy`. Database and Redis URLs come from Terraform.
FERN_SESSION_SECRET=
FERN_COLUMN_API_KEY=
FERN_PLAID_CLIENT_ID=
FERN_PLAID_SECRET=
FERN_PLAID_ENV=sandbox
FERN_ANTHROPIC_API_KEY=
# Cloudflare Zero Trust -> Networks -> Tunnels -> create "fern" -> copy the connector token.
CLOUDFLARE_TUNNEL_TOKEN=
